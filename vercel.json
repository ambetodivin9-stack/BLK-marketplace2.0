{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "blk-boot.js", "use": "@vercel/static" },
    { "src": "blk-extras.js", "use": "@vercel/static" },
    { "src": "blk-fixes.js", "use": "@vercel/static" },
    { "src": "blk-fixes.css", "use": "@vercel/static" },
    { "src": "blk-nozoom.js", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
